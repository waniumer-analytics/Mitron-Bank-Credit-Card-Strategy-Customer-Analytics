            <column caption='AVERAGE INCOME UTILISATION ' datatype='real' name='[Calculation_0214987140063236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0214987153002503]/AVG([Avg Income])' />
            </column>
            <column caption='AVERAGE MONTHLY SPEND' datatype='real' name='[Calculation_0214987153002503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({INCLUDE [Customer ID],[Month]: SUM([Spend])})' />
            </column>
            <column caption='CUSTOMER SEGMENTATION' datatype='string' name='[Calculation_1049791734857729]' role='dimension' type='nominal'>
