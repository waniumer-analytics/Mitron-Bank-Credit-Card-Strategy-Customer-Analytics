  <worksheets>
    <worksheet name=' AVERAGE SPEND KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Customers+' name='federated.0ylwab91rt9d6h141uc100hlfnl9' />
          </datasources>
          <datasource-dependencies datasource='federated.0ylwab91rt9d6h141uc100hlfnl9'>
            <column datatype='string' name='[Age Group]' role='dimension' type='nominal' />
            <column caption='AVERAGE INCOME' datatype='integer' name='[Avg Income]' role='measure' type='quantitative' />
            <column caption='AVERAGE SPEND' datatype='real' name='[Calculation_0214987139518467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Spend])/6' />
            </column>
            <column caption='CUSTOMER SEGMENTATION' datatype='string' name='[Calculation_1049791734857729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Avg Income]&gt;= 80000 THEN &quot;Upper Class&quot;&#13;&#10;ELSEIF [Avg Income]&lt;80000 AND [Avg Income]&gt;=45000 THEN &quot;Middle Class&quot;&#13;&#10;ELSE &quot;Lower Class&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <semantic-values semantic-role='[City].[Name]'>
                <semantic-value key='&quot;Delhi NCR&quot;' value='&quot;New Delhi&quot;' />
              </semantic-values>
            </column>
            <column datatype='string' name='[Customer ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column datatype='string' name='[Marital Status]' role='dimension' type='nominal' />
            <column datatype='string' name='[Month]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;August&quot;' value='Aug' />
                <alias key='&quot;October&quot;' value='Oct' />
                <alias key='&quot;September&quot;' value='Sept' />
              </aliases>
            </column>
            <column datatype='string' name='[Occupation]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Government Employees&quot;' value='Govt Employees' />
              </aliases>
            </column>
            <column datatype='string' name='[Payment Type]' role='dimension' type='nominal' />
            <column caption='SPEND' datatype='integer' name='[Spend]' role='measure' type='quantitative' />
            <column-instance column='[Age Group]' derivation='None' name='[none:Age Group:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1049791734857729]' derivation='None' name='[none:Calculation_1049791734857729:nk]' pivot='key' type='nominal' />
