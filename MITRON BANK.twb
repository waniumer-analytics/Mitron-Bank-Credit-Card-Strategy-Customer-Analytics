              <calculation class='tableau' formula='IF [Avg Income]&gt;= 80000 THEN &quot;Upper Class&quot;&#13;&#10;ELSEIF [Avg Income]&lt;80000 AND [Avg Income]&gt;=45000 THEN &quot;Middle Class&quot;&#13;&#10;ELSE &quot;Lower Class&quot;&#13;&#10;END' />
