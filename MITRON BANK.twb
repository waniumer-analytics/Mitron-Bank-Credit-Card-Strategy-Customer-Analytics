        <column caption='AGE GROUP / OCCUPATION ' datatype='string' name='[Parameter 1049791754903554]' param-domain-type='list' role='measure' type='nominal' value='&quot;Age Group&quot;'>
          <calculation class='tableau' formula='&quot;Age Group&quot;' />
          <members>
            <member value='&quot;Age Group&quot;' />
            <member value='&quot;Occupation&quot;' />
          </members>
